{
	"name": "@pobammer-ts/small-rules",
	"version": "2.16.1",
	"description": "Various Oxlint-native rules for linting roblox-ts projects.",
	"keywords": [
		"lint",
		"linter",
		"linting",
		"oxlint",
		"roblox-ts",
		"typescript"
	],
	"homepage": "https://docs.howmanysmall.com/small-rules/",
	"bugs": {
		"url": "https://github.com/howmanysmall/small-rules/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/howmanysmall/small-rules.git"
	},
	"license": "MIT",
	"author": "HowManySmall",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"THIRD-PARTY-NOTICES.md"
	],
	"scripts": {
		"biome": "biome",
		"build": "tsdown",
		"build:local": "node --run build -- --minify && cp dist/index.js plugins/small-rules.js",
		"build:local:dev": "node --run build && cp dist/index.js plugins/small-rules.js",
		"changelog:version": "bun run scripts/ensure-unreleased.ts && git add CHANGELOG.md",
		"commitlint": "commitlint",
		"docs:build": "nr -F docs build",
		"docs:check": "nr -F docs check",
		"docs:dev": "nr -F docs dev",
		"doctor": "nlx react-doctor@latest",
		"format": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run biome -- check --fix $a && node --run oxfmt -- $a' _",
		"format:check": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run biome -- check --no-errors-on-unmatched $a && node --run oxfmt -- --no-error-on-unmatched-pattern --check $a' _",
		"format:safe": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run biome -- check --no-errors-on-unmatched --fix $a && node --run oxfmt -- --no-error-on-unmatched-pattern $a' _",
		"generate:compact-default-properties": "bun run scripts/generate-compact-default-properties.ts",
		"generate:default-properties": "bun run scripts/generate-default-properties.ts",
		"generate:roblox-yielding-members": "bun run scripts/generate-roblox-yielding-members.ts && node --run format:safe -- src/generated/roblox-yielding-members.ts",
		"generate:third-party-notices": "bun run scripts/generate-third-party-notices.ts",
		"hooks:install": "hk install --mise",
		"hooks:validate": "hk validate",
		"isentinel-lint": "isentinel-lint",
		"jscpd": "jscpd",
		"knip": "knip-bun",
		"knip:production": "knip-bun --production --strict --workspace .",
		"lint": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run isentinel-lint -- $a && node --run biome -- check --no-errors-on-unmatched $a' _",
		"lint:agent": "bash -c 'a=$(bash scripts/get-defaults.sh \"$@\"); node --run isentinel-lint -- --agents $a && node --run biome -- check --no-errors-on-unmatched --reporter concise $a' _",
		"oxfmt": "oxfmt",
		"oxlint": "oxlint",
		"prepublishOnly": "node --run build -- --minify",
		"release": "bumpp",
		"skills": "skills",
		"test": "vitest run",
		"test:agent": "vitest run --reporter agent",
		"test:fuzz": "vitiate regression --config vitest.vitiate.config.ts",
		"test:fuzz:run": "vitiate fuzz --fuzz-time 10 --config vitest.vitiate.config.ts",
		"test:mutation": "stryker run",
		"tsgo": "tsgo",
		"type-check": "tsgo --build",
		"type-check:agent": "node --run type-check -- --pretty false",
		"preversion": "if test -n \"$(git status --porcelain)\"; then echo 'Release requires a clean worktree.' >&2; exit 1; fi"
	},
	"dependencies": {
		"arktype": "catalog:runtime",
		"effect": "catalog:runtime",
		"ignore": "catalog:runtime",
		"minimatch": "catalog:runtime",
		"oxc-resolver": "catalog:runtime",
		"oxlint-plugin-utilities": "catalog:runtime",
		"yuku-parser": "catalog:runtime"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "catalog:build",
		"@biomejs/biome": "catalog:lint",
		"@commitlint/cli": "catalog:commitlint",
		"@commitlint/config-conventional": "catalog:commitlint",
		"@commitlint/types": "catalog:commitlint",
		"@e18e/eslint-plugin": "catalog:lint",
		"@fast-check/vitest": "catalog:test",
		"@isentinel/eslint-config": "catalog:lint",
		"@stryker-mutator/api": "catalog:test",
		"@stryker-mutator/core": "catalog:test",
		"@stryker-mutator/vitest-runner": "catalog:test",
		"@stylistic/eslint-plugin": "catalog:lint",
		"@total-typescript/ts-reset": "catalog:types",
		"@types/bun": "catalog:types",
		"@types/node": "catalog:types",
		"@typescript/native-preview": "catalog:types",
		"@vitest/coverage-v8": "catalog:test",
		"@vitest/eslint-plugin": "catalog:lint",
		"@vitiate/core": "catalog:test",
		"@vitiate/fuzzed-data-provider": "catalog:test",
		"bumpp": "catalog:release",
		"confbox": "catalog:test",
		"eslint": "catalog:lint",
		"eslint-plugin-antfu": "catalog:lint",
		"eslint-plugin-astro": "catalog:lint",
		"eslint-plugin-better-max-params": "catalog:lint",
		"eslint-plugin-comment-length": "catalog:lint",
		"eslint-plugin-de-morgan": "catalog:lint",
		"eslint-plugin-eslint-plugin": "catalog:lint",
		"eslint-plugin-flawless": "catalog:lint",
		"eslint-plugin-jsdoc": "catalog:lint",
		"eslint-plugin-n": "catalog:lint",
		"eslint-plugin-oxfmt": "catalog:lint",
		"eslint-plugin-perfectionist": "catalog:lint",
		"eslint-plugin-react-jsx": "catalog:lint",
		"eslint-plugin-react-naming-convention": "catalog:lint",
		"eslint-plugin-react-x": "catalog:lint",
		"eslint-plugin-roblox-ts": "catalog:lint",
		"eslint-plugin-sonarjs": "catalog:lint",
		"eslint-plugin-unicorn": "catalog:lint",
		"eslint-plugin-unused-imports": "catalog:lint",
		"fast-check": "catalog:test",
		"jiti": "catalog:tooling",
		"jscpd": "catalog:tooling",
		"knip": "catalog:lint",
		"oxfmt": "catalog:lint",
		"oxlint": "catalog:lint",
		"oxlint-plugin-react-doctor": "catalog:lint",
		"oxlint-tsgolint": "catalog:lint",
		"pncat": "catalog:tooling",
		"publint": "catalog:build",
		"react-doctor": "catalog:lint",
		"sfw": "catalog:tooling",
		"skills": "catalog:tooling",
		"tsdown": "catalog:build",
		"type-fest": "catalog:types",
		"typescript": "catalog:types",
		"vitest": "catalog:test",
		"vitiate": "catalog:test",
		"yuku-ast": "catalog:tooling",
		"zx": "catalog:scripts"
	},
	"peerDependencies": {
		"typescript": ">=5 <8"
	},
	"packageManager": "pnpm@12.1.0",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
