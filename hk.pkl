// hk configuration - https://hk.jdx.dev/
amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"

exclude =
  List(
    "node_modules",
    "dist",
    "coverage",
    "report",
    ".git",
    ".repos",
    ".stryker-tmp",
    "do-not-sync-ever",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.woff",
    "**/*.woff2",
    "**/*.ttf",
    "**/*.eot",
    "**/*.pdf",
    "**/*.zip",
    "**/*.tar",
    "**/*.gz",
    "**/*.mp4",
    "**/*.mov",
    "pnpm-lock.yaml",
  )
display_skip_reasons = List()
terminal_progress = true

local ECMA_FILES =
  List(
    "**/*.cjs",
    "**/*.cjsx",
    "**/*.cts",
    "**/*.ctsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.mjsx",
    "**/*.mts",
    "**/*.mtsx",
    "**/*.ts",
    "**/*.tsx",
  )
local ASTRO_FILES = List("**/*.astro")
local MDX_FILES = List("**/*.mdx")
local CSS_FILES = List("**/*.css")
local CSS_EXTENDED_FILES = CSS_FILES + List("**/*.less", "**/*.pcss", "**/*.postcss", "**/*.scss")
local MARKDOWN_FILES = MDX_FILES + List("**/*.md", "**/*.markdown")
local TOML_FILES = List("**/*.toml")
local GRAPHQL_FILES = List("**/*.graphql", "**/*.graphqls", "**/*.gql")
local JSON_FILES = List("**/*.json", "**/*.jsonc")
local YAML_FILES = List("**/*.yaml", "**/*.yml")
local LUAU_FILES = List("**/*.lua", "**/*.luau")
local PACKAGE_JSON_FILES = List("**/package.json")

local BIOME_FILES =
  ECMA_FILES
    + MDX_FILES
    + ASTRO_FILES
    + GRAPHQL_FILES
    + CSS_FILES
    + JSON_FILES
    + List("**/*.svg")
local ISENTINEL_FILES =
  ECMA_FILES
    + TOML_FILES
    + ASTRO_FILES
    + CSS_EXTENDED_FILES
    + JSON_FILES
    + YAML_FILES
    + LUAU_FILES
    + List("**/*.json5")
local FALLOW_FILES =
  ECMA_FILES
    + ASTRO_FILES
    + CSS_FILES
    + PACKAGE_JSON_FILES
local SHERIF_FILES = PACKAGE_JSON_FILES + List("pnpm-workspace.yaml")

local WORKFLOW_FILES =
  List(
    ".github/workflows/**/*.yml",
    ".github/workflows/**/*.yaml",
  )
local WORKFLOW_ACTION_FILES =
  WORKFLOW_FILES + List(".github/actions/**/action.yml", ".github/actions/**/action.yaml")
local ZIZMOR_FILES = WORKFLOW_ACTION_FILES + List(".github/dependabot.yml")

local pullhook = new Step {
  check = "pullhook run"
}

// One shared step mapping for the check, fix, and pre-commit hooks.
// Each hook below assigns it wholesale instead of redefining every step.
local linters = new Mapping<String, Step> {
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-symlinks"] = Builtins.check_symlinks
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["detect-private-key"] = Builtins.detect_private_key
  ["betterleaks"] = Builtins.betterleaks
  ["sherif"] {
    glob = SHERIF_FILES
    check = "sherif -r root-package-private-field -r root-package-dependencies"
    fix = "sherif --fix --no-install -r root-package-private-field -r root-package-dependencies"
  }
  // tsconfig project references are derived from each package.json, and a
  // missing one is silent: tsgo --build still resolves the import through
  // the root node_modules and skips the project.
  ["tsconfig-references"] {
    glob = List("**/package.json", "**/tsconfig.json")
    check = "node --run references:check"
    fix = "node --run references:sync"
  }

  // JS/TS pipeline — isentinel-lint + biome + oxfmt.
  // Nothing here batches: isentinel-lint pays ESLint's startup cost on every
  // invocation, so one invocation over all files beats N batches that each
  // repay it. Same for biome/oxfmt, whose startups would just add node
  // invocations. A single-file change is one batch either way.
  ["isentinel-lint"] {
    glob = ISENTINEL_FILES
    check = "node --run isentinel-lint -- {{files}}"
    fix = "node --run isentinel-lint -- --fix {{files}}"
    check_first = true
    batch = false
  }
  ["biome-js"] = (Builtins.biome) {
    glob = BIOME_FILES
    check = "node --run biome -- check --no-errors-on-unmatched {{files}}"
    fix = "node --run biome -- check --write --no-errors-on-unmatched {{files}}"
    check_first = true
    batch = false
  }

  // Biome non-JS — css, html, grit
  ["biome-non-js"] = (Builtins.biome) {
    glob = List("*.css", "*.html", "*.grit")
    check = "node --run biome -- check --no-errors-on-unmatched {{files}}"
    fix = "node --run biome -- check --write --no-errors-on-unmatched {{files}}"
    check_first = true
    batch = false
  }

  // Single oxfmt step for every file type it handles.
  // Note: .astro is intentionally excluded. oxfmt does not support it.
  ["oxfmt"] = (Builtins.oxfmt) {
    glob =
      List(
        "*.js",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.mjs",
        "*.cjs",
        "*.mts",
        "*.cts",
        "*.json",
        "*.jsonc",
        "*.json5",
        "*.code-workspace",
        "*.mdx",
      )
    exclude = List("skills-lock.json")
    check = "node --run oxfmt -- --no-error-on-unmatched-pattern --check {{files}}"
    fix = "node --run oxfmt -- --no-error-on-unmatched-pattern {{files}}"
    check_first = true
  }

  // Pkl — hk and other typed config files
  ["pkl-format"] = (Builtins.pkl_format) {
    glob = List("*.pkl")
    check_first = true
  }

  // Shell scripts
  ["shfmt"] {
    glob = List("**/*.sh", "**/*.bash", "**/*.ksh")
    check = "shfmt -bn -ci -sr -d {{files}}"
    fix = "shfmt -bn -ci -sr -w {{files}}"
    check_first = true
  }
  ["shfmt-detected-shell"] {
    types = List("shell")
    exclude = List("**/*.sh", "**/*.bash", "**/*.fish", "**/*.ksh")
    check = "shfmt -bn -ci -sr -d {{files}}"
    fix = "shfmt -bn -ci -sr -w {{files}}"
    check_first = true
  }
  ["shellcheck"] {
    glob = List("**/*.sh", "**/*.bash", "**/*.ksh", "**/*.dash", "**/*.zsh")
    check = "shellcheck {{files}}"
  }
  ["shellcheck-detected-shell"] {
    types = List("shell")
    exclude = List("**/*.sh", "**/*.bash", "**/*.dash", "**/*.fish", "**/*.ksh", "**/*.zsh")
    check = "shellcheck {{files}}"
  }

  // GitHub Actions workflows
  ["actionlint"] = (Builtins.actionlint) {
    glob = WORKFLOW_FILES
    check =
      "actionlint -ignore 'specifying action .[$]/.github/.*. in invalid format' -ignore 'reusable workflow call .[$]/.github/.*. at .uses. is not following the format' {{files}}"
  }
  ["zizmor"] = (Builtins.zizmor) {
    glob = ZIZMOR_FILES
    check = "GH_TOKEN=\"$(gh auth token)\" zizmor --no-progress {{files}}"
    check_diff = "GH_TOKEN=\"$(gh auth token)\" zizmor --no-progress {{files}}"
    fix = "GH_TOKEN=\"$(gh auth token)\" zizmor --no-progress --fix {{files}}"
  }
  ["pinact"] {
    glob = WORKFLOW_ACTION_FILES
    check = new CommandSpec {
      command = "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run --verify {{files}}"
      effect = "read"
    }
    fix = new CommandSpec {
      command = "PINACT_GITHUB_TOKEN=\"$(gh auth token)\" pinact run {{files}}"
      effect = "write"
    }
    check_first = true
  }

  // Markdown — rumdl lint + fmt
  ["vale"] = (Builtins.vale) {
    glob = MARKDOWN_FILES
  }
  ["rumdl"] = (Builtins.rumdl) {
    glob = MARKDOWN_FILES
    exclude = List(".agents/skills/**/SKILL.md")
    check = "rumdl check {{files}}"
    fix =
      """
      rumdl check --fix {{files}}
      rumdl fmt {{files}}
      """
    check_first = true
  }

  // TOML — tombi lint + format
  ["tombi"] = (Builtins.tombi) {
    glob = TOML_FILES
    check = "tombi lint {{files}} && tombi format --check {{files}}"
    fix =
      """
      tombi lint {{files}}
      tombi format {{files}}
      """
    check_first = true
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }

  ["check"] {
    steps = linters
  }

  ["fix"] {
    fix = true
    stash = "git"
    steps = linters
  }

  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check =
          "node --run commitlint -- --strict --config commitlint.config.ts --edit {{commit_msg_file}}"
      }
    }
  }

  ["pre-push"] {
    steps {
      ["type-check"] {
        check = "mise run type-check"
      }
      // fallow — changed-code quality gate (dead code, duplication, health).
      // Gates on `new-only`, so inherited findings on touched files report but
      // do not block. Runs once per commit, not per file.
      ["fallow"] {
        glob = FALLOW_FILES
        check = "mise run fallow:audit-hk"
      }
      ["lint"] {
        check = "mise run lint"
      }
      ["dead-code"] {
        check = "mise run dead-code"
      }
      ["duplicates"] {
        check = "mise run duplicates"
      }
      ["build"] {
        check = "mise run build"
      }
      ["test"] {
        check = "mise run test"
      }
      // Mirror CI's Workflow Security job so bad workflow edits fail here,
      // not after burning CI minutes. Unconditional: the trio is fast and
      // pre-commit can be bypassed with --no-verify.
      ["workflow-security"] {
        check =
          """
          actionlint -ignore 'specifying action .[$]/.github/.*. in invalid format' -ignore 'reusable workflow call .[$]/.github/.*. at .uses. is not following the format'
          zizmor --no-progress .github
          pinact run -fix=false -no-api $(find .github/workflows .github/actions -name '*.yaml' -o -name '*.yml')
          """
      }
    }
  }

  ["post-merge"] {
    steps {
      ["pullhook"] = pullhook
    }
  }

  ["post-checkout"] {
    steps {
      ["pullhook"] = pullhook
    }
  }

  ["post-rewrite"] {
    steps {
      ["pullhook"] = pullhook
    }
  }
}
