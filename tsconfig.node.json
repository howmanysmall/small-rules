{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tsbuildinfo-node",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"rootDir": ".",
		"types": ["bun", "node"],
		"sourceMap": false
	},
	"include": [
		"*.config.ts",
		"documentation/src/classes/extraction-error.ts",
		"documentation/src/data/generated/rule-relations.json",
		"documentation/src/data/rule-examples.ts",
		"documentation/src/data/rule-facts.ts",
		"documentation/src/data/rule-manifest.ts",
		"documentation/src/data/rule-options.ts",
		"documentation/src/data/rule-relations.overrides.ts",
		"documentation/src/data/rule-relations.ts",
		"documentation/src/utilities/extract-rule-examples.ts",
		"documentation/src/utilities/oxlint-config.ts",
		"packages/*/src/**/*.ts",
		"packages/*/vitest.config.ts",
		"scripts/**/*.ts",
		"src/**/*.ts"
	],
	"exclude": ["dist", "node_modules"]
}
