{
	"$schema": "node_modules/fallow/schema.json",
	"entry": [
		"src/index.ts",
		"src/reset.d.ts",
		"*.config.ts",
		"scripts/*.ts",
		"tests/**/*.fuzz.ts",
		"documentation/src/components/overrides/*.astro",
		"documentation/src/styles/custom.css"
	],
	"ignorePatterns": [
		"tests/fixtures/**",
		"plugins/**",
		"src/generated/**",
		".benchmarks/**",
		".codex/**",
		".opencode/**",
		".omp/**",
		"tests/rule-harness/**"
	],
	"ignoreDependencies": [
		"@arethetypeswrong/core",
		"@astrojs/markdown-satteri",
		"@fast-check/vitest",
		"@isentinel/hooks",
		"@total-typescript/ts-reset",
		"babel-plugin-react-compiler",
		"fast-check",
		"hast",
		"jiti",
		"mdast-util-directive",
		"mdast",
		"publint",
		"sfw",
		"sharp"
	],
	"ignoreDependencyOverrides": [{ "package": "vite", "source": "pnpm-workspace.yaml" }],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"unused-files": "error",
		"unused-exports": "error",
		"unused-types": "error",
		"unused-dependencies": "error",
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"unused-enum-members": "error",
		"unlisted-dependencies": "error",
		"unresolved-imports": "error",
		"duplicate-exports": "error",
		"circular-dependencies": "error",
		"re-export-cycle": "error",
		"type-only-dependencies": "error",
		"test-only-dependencies": "error",
		"unused-dependency-overrides": "error",
		"stale-suppressions": "error"
	},
	"health": {
		"maxCyclomatic": 20,
		"maxCognitive": 15,
		"maxCrap": 30,
		"crapRefactorBand": 5,
		"maxUnitSize": 60,
		"coverage": "coverage/coverage-final.json",
		"coverageRoot": null,
		"ignore": ["scripts/**"],
		"ownership": {
			"botPatterns": [
				"*\\[bot\\]*",
				"dependabot*",
				"renovate*",
				"github-actions*",
				"svc-*",
				"*-service-account*"
			],
			"emailMode": "handle"
		},
		"suggestInlineSuppression": true
	},
	"overrides": [],
	"duplicates": {
		"mode": "mild",
		"minLines": 5,
		"minTokens": 50,
		"threshold": 0.5,
		"ignoreDefaults": true,
		"ignore": [
			"documentation/src/styles/custom.css",
			"src/rules/anti-slop/**",
			"tests/fixtures/**",
			"scripts/utilities/casing-utilities.ts"
		]
	},
	"audit": {
		"gate": "new-only"
	}
}
