{
	"$schema": "https://opencode.ai/config.json",
	"agents": {
		"ask": {
			"color": "#7C3AED",
			"description": "General Q&A - ask questions about code, concepts, debugging strategies without executing anything",
			"disabled": false,
			"mode": "all",
			"permissions": [
				{ "action": "shell", "effect": "allow", "resource": "*" },
				{ "action": "codesearch", "effect": "allow", "resource": "*" },
				{ "action": "doom_loop", "effect": "deny", "resource": "*" },
				{ "action": "edit", "effect": "deny", "resource": "*" },
				{ "action": "external_directory", "effect": "deny", "resource": "*" },
				{ "action": "glob", "effect": "allow", "resource": "*" },
				{ "action": "grep", "effect": "allow", "resource": "*" },
				{ "action": "list", "effect": "allow", "resource": "*" },
				{ "action": "lsp", "effect": "allow", "resource": "*" },
				{ "action": "question", "effect": "allow", "resource": "*" },
				{ "action": "read", "effect": "allow", "resource": "*" },
				{ "action": "skill", "effect": "allow", "resource": "*" },
				{ "action": "subagent", "effect": "allow", "resource": "*" },
				{ "action": "todoread", "effect": "allow", "resource": "*" },
				{ "action": "todowrite", "effect": "allow", "resource": "*" },
				{ "action": "webfetch", "effect": "allow", "resource": "*" },
				{ "action": "websearch", "effect": "allow", "resource": "*" },
			],
			"request": {
				"body": { "temperature": 0.3 },
			},
			"system": "# Q&A Assistant\n\nYou answer questions about code, architecture, debugging strategies, and technical concepts. You do NOT execute code or make edits—just provide knowledge.\n\n## Response Style\n\n- **Concise first** - lead with the direct answer, expand only if needed\n- **Code snippets** - show minimal examples when helpful, not full implementations\n- **No hedging** - if you know it, say it; if you don't, say that\n- **Cite sources** - mention docs/specs when relevant\n\n## What You Handle\n\n- Explain how X works\n- Debug strategy suggestions (without running anything)\n- API/library usage questions\n- Architecture tradeoffs\n- \"Why is this happening?\" conceptual debugging\n- Best practices and patterns\n- Compare/contrast approaches\n\n## What You Decline\n\n- \"Write me X\" (that's for coding agents)\n- \"Run this and tell me what happens\"\n- Tasks requiring file system access\n\nIf user needs execution or edits, tell them to switch agents.\n\n## Format\n\n- Short answers for short questions\n- Use headers only for multi-part responses\n- Code blocks with language tags\n- Lists only when comparing multiple items\n",
		},
		"ask-fable": {
			"mode": "subagent",
			"model": "github-copilot/claude-fable-5.1",
			"system": "# Q&A Assistant\n\nYou answer questions about code, architecture, debugging strategies, and technical concepts. You do NOT execute code or make edits—just provide knowledge.\n\n## Response Style\n\n- **Concise first** - lead with the direct answer, expand only if needed\n- **Code snippets** - show minimal examples when helpful, not full implementations\n- **No hedging** - if you know it, say it; if you don't, say that\n- **Cite sources** - mention docs/specs when relevant\n\n## What You Handle\n\n- Explain how X works\n- Debug strategy suggestions (without running anything)\n- API/library usage questions\n- Architecture tradeoffs\n- \"Why is this happening?\" conceptual debugging\n- Best practices and patterns\n- Compare/contrast approaches\n\n## What You Decline\n\n- \"Write me X\" (that's for coding agents)\n- \"Run this and tell me what happens\"\n- Tasks requiring file system access\n\nIf user needs execution or edits, tell them to switch agents.\n\n## Format\n\n- Short answers for short questions\n- Use headers only for multi-part responses\n- Code blocks with language tags\n- Lists only when comparing multiple items\n",
		},
	},
	"autoupdate": true,
	"commands": {
		"goal": {
			"agent": "build",
			"description": "Set a session-scoped goal and auto-continue until complete.",
			"template": "$ARGUMENTS",
		},
	},
	"compaction": {
		"auto": true,
	},
	"disabled_providers": [],
	"formatter": {
		"biome": {
			"command": ["node", "--run", "biome", "--", "format", "--write", "$FILE"],
			"extensions": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".json",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"oxfmt": {
			"command": ["node", "--run", "oxfmt", "--", "$FILE"],
			"extensions": [
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".handlebars",
				".hbs",
				".htm",
				".html",
				".js",
				".json",
				".json5",
				".jsonc",
				".jsx",
				".less",
				".mdx",
				".mjs",
				".mts",
				".sass",
				".scss",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"rumdl": {
			"command": ["rumdl", "check", "--fix", "$FILE"],
			"extensions": [
				".md",
				".markdown",
				".mdown",
				".mkdn",
				".mkd",
				".mdwn",
				".mdtxt",
				".mdtext",
				".text",
				".Rmd",
			],
		},
		"tombi": {
			"command": ["tombi", "format", "$FILE"],
			"extensions": [".toml"],
		},
	},
	"instructions": ["./AGENTS.md"],
	"lsp": {
		"biome": {
			"command": ["node", "--run", "biome", "--", "lsp-proxy"],
			"extensions": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".json",
				".jsonc",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"oxfmt": {
			"command": ["node", "--run", "oxfmt", "--", "--lsp"],
			"extensions": [
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".handlebars",
				".hbs",
				".htm",
				".html",
				".js",
				".json",
				".json5",
				".jsonc",
				".jsx",
				".less",
				".mdx",
				".mjs",
				".mts",
				".sass",
				".scss",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml",
			],
		},
		"oxlint": {
			"command": ["node", "--run", "oxlint", "--", "--lsp"],
			"extensions": [".js", ".mjs", ".cjs", ".ts", ".mts", ".cts", ".jsx", ".tsx", ".vue", ".svelte", ".astro"],
		},
		"rumdl": {
			"command": ["rumdl", "server"],
			"extensions": [
				".md",
				".markdown",
				".mdown",
				".mkdn",
				".mkd",
				".mdwn",
				".mdtxt",
				".mdtext",
				".text",
				".Rmd",
			],
		},
		"tombi": {
			"command": ["tombi", "lsp"],
			"extensions": [".toml"],
		},
		"typescript": {
			"command": ["node", "--run", "tsgo", "--", "--lsp", "--stdio"],
			"extensions": [".ts", ".tsx"],
		},
	},
	"mcp": {
		"servers": {
			"astro-docs": {
				"type": "remote",
				"url": "https://mcp.docs.astro.build/mcp",
			},
			"chrome-devtools": {
				"command": ["bash", "scripts/get-chrome-path.sh", "--serve"],
				"disabled": false,
				"type": "local",
			},
			"context7": {
				"disabled": false,
				"headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
				"type": "remote",
				"url": "https://mcp.context7.com/mcp",
			},
			"fallow": {
				"command": ["node", "--run", "fallow-mcp"],
				"type": "local",
			},
			"gh-grep": {
				"disabled": true,
				"type": "remote",
				"url": "https://mcp.grep.app",
			},
			"github": {
				"disabled": true,
				"headers": { "Authorization": "Bearer {env:GITHUB_PAT}" },
				"type": "remote",
				"url": "https://api.githubcopilot.com/mcp/",
			},
			"hk": {
				"command": ["mise", "x", "--", "hk", "mcp", "--root", "."],
				"disabled": false,
				"type": "local",
			},
			"jsr": {
				"command": ["mise", "x", "--", "jsr-cli", "mcp"],
				"disabled": true,
				"type": "local",
			},
			"npm-registry": {
				"command": ["mise", "x", "--", "npm-registry-mcp"],
				"disabled": true,
				"type": "local",
			},
			"openrouter-mcp": {
				"type": "remote",
				"url": "https://mcp.openrouter.ai/mcp",
			},
			"paper": {
				"type": "remote",
				"url": "http://127.0.0.1:29979/mcp",
			},
		},
	},
	"permissions": [
		{ "action": "shell", "effect": "allow", "resource": "*" },
		{ "action": "shell", "effect": "allow", "resource": "bat *" },
		{ "action": "shell", "effect": "allow", "resource": "bat*" },
		{ "action": "shell", "effect": "allow", "resource": "cat *" },
		{ "action": "shell", "effect": "allow", "resource": "cat*" },
		{ "action": "shell", "effect": "allow", "resource": "cd *" },
		{ "action": "shell", "effect": "allow", "resource": "cd*" },
		{ "action": "shell", "effect": "allow", "resource": "date*" },
		{ "action": "shell", "effect": "allow", "resource": "delta *" },
		{ "action": "shell", "effect": "allow", "resource": "delta*" },
		{ "action": "shell", "effect": "allow", "resource": "diff *" },
		{ "action": "shell", "effect": "allow", "resource": "diff*" },
		{ "action": "shell", "effect": "allow", "resource": "du *" },
		{ "action": "shell", "effect": "allow", "resource": "du*" },
		{ "action": "shell", "effect": "allow", "resource": "dust *" },
		{ "action": "shell", "effect": "allow", "resource": "dust*" },
		{ "action": "shell", "effect": "allow", "resource": "echo*" },
		{ "action": "shell", "effect": "allow", "resource": "exa *" },
		{ "action": "shell", "effect": "allow", "resource": "exa*" },
		{ "action": "shell", "effect": "allow", "resource": "fd *" },
		{ "action": "shell", "effect": "allow", "resource": "fd*" },
		{ "action": "shell", "effect": "allow", "resource": "find *" },
		{ "action": "shell", "effect": "allow", "resource": "find*" },
		{ "action": "shell", "effect": "allow", "resource": "git diff*" },
		{ "action": "shell", "effect": "allow", "resource": "git log*" },
		{ "action": "shell", "effect": "allow", "resource": "git ls-files*" },
		{ "action": "shell", "effect": "allow", "resource": "git rev-parse*" },
		{ "action": "shell", "effect": "allow", "resource": "git show*" },
		{ "action": "shell", "effect": "allow", "resource": "git status *" },
		{ "action": "shell", "effect": "allow", "resource": "git status*" },
		{ "action": "shell", "effect": "allow", "resource": "grep *" },
		{ "action": "shell", "effect": "allow", "resource": "grep*" },
		{ "action": "shell", "effect": "allow", "resource": "head*" },
		{ "action": "shell", "effect": "allow", "resource": "ls *" },
		{ "action": "shell", "effect": "allow", "resource": "ls*" },
		{ "action": "shell", "effect": "allow", "resource": "lsd *" },
		{ "action": "shell", "effect": "allow", "resource": "lsd*" },
		{ "action": "shell", "effect": "allow", "resource": "mkdir*" },
		{ "action": "shell", "effect": "allow", "resource": "pwd*" },
		{ "action": "shell", "effect": "allow", "resource": "rg *" },
		{ "action": "shell", "effect": "allow", "resource": "rg*" },
		{ "action": "shell", "effect": "allow", "resource": "sd *" },
		{ "action": "shell", "effect": "allow", "resource": "sd*" },
		{ "action": "shell", "effect": "allow", "resource": "sed *" },
		{ "action": "shell", "effect": "allow", "resource": "sed*" },
		{ "action": "shell", "effect": "allow", "resource": "sort*" },
		{ "action": "shell", "effect": "allow", "resource": "tail*" },
		{ "action": "shell", "effect": "allow", "resource": "tree*" },
		{ "action": "shell", "effect": "allow", "resource": "wc*" },
		{ "action": "codesearch", "effect": "allow", "resource": "*" },
		{ "action": "doom_loop", "effect": "allow", "resource": "*" },
		{ "action": "edit", "effect": "allow", "resource": "*" },
		{ "action": "edit", "effect": "deny", "resource": "**/.oxfmtrc.json" },
		{ "action": "edit", "effect": "deny", "resource": "**/.oxlintrc.json" },
		{ "action": "edit", "effect": "deny", "resource": "**/biome.jsonc" },
		{ "action": "external_directory", "effect": "allow", "resource": "*" },
		{ "action": "glob", "effect": "allow", "resource": "*" },
		{ "action": "grep", "effect": "allow", "resource": "*" },
		{ "action": "list", "effect": "allow", "resource": "*" },
		{ "action": "lsp", "effect": "allow", "resource": "*" },
		{ "action": "question", "effect": "allow", "resource": "*" },
		{ "action": "read", "effect": "allow", "resource": "*" },
		{ "action": "skill", "effect": "allow", "resource": "*" },
		{ "action": "subagent", "effect": "allow", "resource": "*" },
		{ "action": "todoread", "effect": "allow", "resource": "*" },
		{ "action": "todowrite", "effect": "allow", "resource": "*" },
		{ "action": "webfetch", "effect": "allow", "resource": "*" },
		{ "action": "websearch", "effect": "allow", "resource": "*" },
	],
	"plugins": ["@nick-vi/opencode-type-inject", "@mohak34/opencode-notifier@latest", "opencode-goal-plugin"],
	"shell": "fish",
}
