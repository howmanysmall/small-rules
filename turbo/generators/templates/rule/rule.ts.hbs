import { createRule } from "$oxc-utilities/create-rule";

import type { Visitor } from "oxlint-plugin-utilities";

const {{camelCase name}} = createRule("{{name}}", "{{category}}", {
	createOnce(): Visitor {
		return {} satisfies Visitor;
	},
	meta: {
		docs: {
			description: {{{json description}}},
		},
		messages: {
			{{camelCase name}}: {{{json message}}},
		},
		schema: [] as const,
		type: "problem",
	},
});

export default {{camelCase name}};
