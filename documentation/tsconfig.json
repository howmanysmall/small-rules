{
	"extends": ["astro/tsconfigs/strictest", "../tsconfig.paths.json"],
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "node_modules/.tsbuildinfo",
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	},
	"include": [
		".astro/types.d.ts",
		"astro.config.ts",
		"playwright.config.ts",
		"reset.d.ts",
		"src/**/*",
		"tests/**/*",
		"vitest.config.ts"
	],
	"exclude": ["dist", "node_modules"]
}
