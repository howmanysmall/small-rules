{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "node_modules/.tsbuildinfo",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"$oxc-generated/*": ["../src/generated/*"],
			"$oxc-rules/*": ["../src/rules/*"],
			"$oxc-types/*": ["../src/types/*"],
			"$oxc-utilities/*": ["../src/utilities/*"],
			"$small-rules": ["../src/index.ts"],
			"@/*": ["./src/*"]
		}
	},
	"include": [
		".astro/types.d.ts",
		"astro.config.ts",
		"playwright.config.ts",
		"reset.d.ts",
		"src/**/*",
		"tests/**/*",
		"vitest.config.ts"
	],
	"exclude": ["dist", "node_modules"]
}
