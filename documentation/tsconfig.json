{
	"extends": ["../tsconfig.base.json", "astro/tsconfigs/strictest"],
	"compilerOptions": {
		"tsBuildInfoFile": "node_modules/.tsbuildinfo",
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"$classes/*": ["./src/classes/*"],
			"$components/*": ["./src/components/*"],
			"$data/*": ["./src/data/*"],
			"$utilities/*": ["./src/utilities/*"],
			"$small-rules": ["../src/index.ts"]
		}
	},
	"references": [
		{
			"path": "../src"
		}
	],
	"include": [
		".astro/types.d.ts",
		"astro.config.ts",
		"playwright.config.ts",
		"reset.d.ts",
		"src/**/*",
		"tests/**/*",
		"vitest.config.ts"
	],
	"exclude": ["dist", "node_modules"]
}
