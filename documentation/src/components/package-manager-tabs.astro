---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";

type Preset = "install" | "run";

interface Props {
	readonly preset?: Preset | undefined;
}

const { preset = "install" } = Astro.props;

const managers = [
	{ install: "ni -D @pobammer-ts/small-rules oxlint", label: "ni", run: "nr lint" },
	{ install: "pnpm add --save-dev @pobammer-ts/small-rules oxlint", label: "pnpm", run: "pnpm run lint" },
	{ install: "aube add --save-dev @pobammer-ts/small-rules oxlint", label: "aube", run: "aube run lint" },
	{ install: "vp add --dev @pobammer-ts/small-rules oxlint", label: "vp", run: "vp run lint" },
	{ install: "deno add npm:@pobammer-ts/small-rules npm:oxlint", label: "deno", run: "deno task lint" },
	{ install: "bun add --dev @pobammer-ts/small-rules oxlint", label: "bun", run: "bun run lint" },
	{ install: "yarn add --dev @pobammer-ts/small-rules oxlint", label: "yarn", run: "yarn run lint" },
	{ install: "npm install --save-dev @pobammer-ts/small-rules oxlint", label: "npm", run: "npm run lint" },
];
---

<Tabs syncKey="package-manager">
	{managers.map(({ install, label, run }) => (
		<TabItem label={label}>
			<Code code={preset === "install" ? install : run} lang="bash" />
		</TabItem>
	))}
</Tabs>
