---
import { Badge } from "$components/badge";
import { isBadgeVariant } from "$components/badge-variants";
import InlineMarkdownText from "$components/inline-markdown-text.astro";

import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type SidebarEntry = StarlightRouteData["sidebar"][number];

interface Props {
	readonly badge: SidebarEntry["badge"];
	readonly label: SidebarEntry["label"];
	readonly large?: boolean | undefined;
}

const { badge, label, large } = Astro.props;
const badgeVariant = badge?.class;
---

<span class:list={{ large }}>
	<InlineMarkdownText text={label} />
</span>
{isBadgeVariant(badgeVariant) && <Badge compact={true} variant={badgeVariant} />}
