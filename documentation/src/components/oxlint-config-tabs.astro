---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";

import { formatJsonSource, toTsConfigSource } from "$utilities/oxlint-config";

interface Props {
	/**
	 * The `.oxlintrc.json` file contents. The `oxlint.config.ts` tab is derived
	 * from it.
	 */
	readonly json: string;
}

const { json } = Astro.props;
const formattedJson = formatJsonSource(json);
const ts = toTsConfigSource(json);
---

<div class="oxlint-config-tabs">
	<Tabs syncKey="oxlint-config">
		<TabItem label=".oxlintrc.json">
			<Code code={formattedJson} lang="json" />
		</TabItem>
		<TabItem label="oxlint.config.ts">
			<Code code={ts} lang="ts" />
		</TabItem>
	</Tabs>
</div>
