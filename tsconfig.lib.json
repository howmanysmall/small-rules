{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.tsbuildinfo-lib",
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["node"]
	},
	"include": ["packages/*/src/**/*.ts", "src/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
