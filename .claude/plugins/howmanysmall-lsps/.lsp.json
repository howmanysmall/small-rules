{
	"bash": {
		"args": ["start"],
		"command": "bash-language-server",
		"extensionToLanguage": {
			".bash": "shellscript",
			".ksh": "shellscript",
			".sh": "shellscript",
			".zsh": "shellscript"
		}
	},
	"lsp-mux": {
		"args": ["${CLAUDE_PLUGIN_ROOT}/lsp-mux.js", "${CLAUDE_PLUGIN_ROOT}/lsp-mux.json"],
		"command": "bun",
		"extensionToLanguage": {
			".astro": "astro",
			".cjs": "javascript",
			".css": "css",
			".cts": "typescript",
			".gql": "graphql",
			".graphql": "graphql",
			".handlebars": "handlebars",
			".hbs": "handlebars",
			".htm": "html",
			".html": "html",
			".js": "javascript",
			".json": "json",
			".json5": "json5",
			".jsonc": "jsonc",
			".jsx": "javascriptreact",
			".less": "less",
			".mdx": "mdx",
			".mjs": "javascript",
			".mts": "typescript",
			".sass": "sass",
			".scss": "scss",
			".svelte": "svelte",
			".ts": "typescript",
			".tsx": "typescriptreact",
			".vue": "vue",
			".yaml": "yaml",
			".yml": "yaml"
		}
	},
	"rumdl": {
		"args": ["server"],
		"command": "rumdl",
		"extensionToLanguage": {
			".Rmd": "rmarkdown",
			".markdown": "markdown",
			".md": "markdown",
			".mdown": "markdown",
			".mdtext": "markdown",
			".mdtxt": "markdown",
			".mdwn": "markdown",
			".mkd": "markdown",
			".mkdn": "markdown",
			".text": "plaintext"
		}
	},
	"tombi": {
		"args": ["lsp"],
		"command": "tombi",
		"extensionToLanguage": {
			".toml": "toml"
		}
	}
}
