{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"enabledPlugins": {
		"howmanysmall-lsps@howmanysmall": true
	},
	"extraKnownMarketplaces": {
		"howmanysmall": {
			"source": {
				"path": ".",
				"source": "directory"
			}
		}
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fallow-gate.sh"
					}
				]
			}
		]
	}
}
