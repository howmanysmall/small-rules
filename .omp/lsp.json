{
	"servers": {
		"biome": {
			"args": ["--run", "biome", "--", "lsp-proxy"],
			"command": "node",
			"fileTypes": [
				".astro",
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".html",
				".js",
				".jsx",
				".mjs",
				".mts",
				".scss",
				".svelte",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml"
			],
			"isLinter": true,
			"languageId": "biome",
			"rootMarkers": ["biome.json", "biome.jsonc", ".git"]
		},
		"oxfmt": {
			"args": ["--run", "oxfmt", "--", "--lsp"],
			"command": "node",
			"fileTypes": [
				".cjs",
				".css",
				".cts",
				".gql",
				".graphql",
				".handlebars",
				".hbs",
				".htm",
				".html",
				".js",
				".json5",
				".jsx",
				".less",
				".mdx",
				".mjs",
				".mts",
				".sass",
				".scss",
				".ts",
				".tsx",
				".vue",
				".yaml",
				".yml"
			],
			"isLinter": true,
			"languageId": "oxfmt",
			"rootMarkers": [".oxfmtrc.json", ".git"]
		},
		"oxlint": {
			"args": ["--run", "oxlint", "--", "--lsp"],
			"command": "node",
			"fileTypes": [".js", ".mjs", ".cjs", ".ts", ".mts", ".cts", ".jsx", ".tsx", ".vue", ".svelte", ".astro"],
			"isLinter": true,
			"languageId": "oxlint",
			"rootMarkers": [".oxlintrc.json", ".git"]
		},
		"pkl-lsp": {
			"command": "pkl-lsp",
			"fileTypes": [".pkl"],
			"languageId": "pkl",
			"rootMarkers": ["hk.pkl", "*.pkl", ".git"]
		},
		"rumdl": {
			"args": ["server"],
			"command": "rumdl",
			"fileTypes": [".md", ".markdown", ".mdown", ".mkdn", ".mkd", ".mdwn", ".mdtxt", ".mdtext", ".text", ".Rmd"],
			"languageId": "markdown",
			"rootMarkers": [".git"]
		},
		"tombi": {
			"args": ["lsp"],
			"command": "tombi",
			"fileTypes": [".toml"],
			"languageId": "toml",
			"rootMarkers": ["Cargo.toml", "pyproject.toml", ".git"]
		},
		"typescript": {
			"args": ["--run", "tsgo", "--", "--lsp", "--stdio"],
			"command": "node",
			"fileTypes": [".ts", ".tsx", ".js", ".jsx", ".mts", ".cts", ".mjs", ".cjs"],
			"languageId": "typescript",
			"rootMarkers": ["tsconfig.json", "package.json", ".git"]
		},
		"typescript-language-server": {
			"disabled": true
		},
		"vscode-html-language-server": {
			"args": ["--stdio"],
			"command": "vscode-html-language-server",
			"fileTypes": [".html", ".htm"],
			"languageId": "html",
			"rootMarkers": [".git"]
		},
		"vscode-json-language-server": {
			"args": ["--stdio"],
			"command": "vscode-json-language-server",
			"fileTypes": [".json", ".jsonc"],
			"languageId": "json",
			"rootMarkers": ["package.json", "tsconfig.json", ".git"]
		}
	}
}
